/*
 * the model is accurate for 0-100 km/h range
 */
[55.56] v_max;  // [200 km/h] maximum speed of a car (m/s)
[27.78] v_100;  // m/s
[3.028e-4] drag; // some average value (1/m)
[5.25] a_d; 
[1.0] mu; 
[0.05776] alpha; 
[1.2] t_react;

[0,1000] s; // distance m
[0,27.78] v; // velocity m/s (16.67 m/s = 60 km/h)
[0,30] tau; // time in seconds
[0,30] time;
dist_normal(4,0.1) beta;

// accelerating
{
mode 1;
flow:
d/dt[s]= v;
d/dt[v]= alpha*exp(-alpha*tau+beta)-drag*v*v;
d/dt[tau]= 1.0;
jump:
(and (v >= v_100))==>@2(and(s'=s)(v'=v)(tau'=0)(beta'=beta));
}

// reacting
{
mode 2;
flow:
d/dt[s]= v;
d/dt[v]= -drag*v*v;
d/dt[tau]= 1.0;
jump:
(and (tau = t_react))==>@3(and(s'=s)(v'=v)(tau'=0)(beta'=beta));
}

// braking
{
mode 3;
flow:
d/dt[s]= v;
d/dt[v]= -a_d-drag*v*v;
d/dt[tau]= 1.0;
jump:
(and (v <= 0))==>@4(and(s'=s)(v'=v)(tau'=0)(beta'=beta));
}

// stopped
{
mode 4;
flow:
d/dt[s]= v;
d/dt[v]= 0.0;
d/dt[tau]= 1.0;
jump:

}

init:
@1(and (s = 0) (v = 0) (tau = 0));

goal:
@4(and(tau=0)(s>=400));
